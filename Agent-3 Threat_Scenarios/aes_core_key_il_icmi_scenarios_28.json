  },
  "primary": {
    "signal": "aes_cipher_top.key",
    "security_objective": "confidentiality"
  },
  "threat": "information_leakage",
  "feature": "temporal_incremental_conditional_mutual_information_auc",
  "bindings": {
    "primary": {
      "placeholder": "$primary",
      "rtl_signal": "aes_cipher_top.key"
    },
    "candidate": {
      "placeholder": "$candidate",
      "source": "functionally retained candidate supplied to the downstream agent"
    },
    "clock": "clk",
    "reset": {
      "signal": "rst",
      "active_level": "low"
    },
    "uop": {
      "placeholder": "$uop",
      "rtl_signal": "aes_cipher_top.text_out"
    },
    "parameters": {
      "$anchor": "the current scenario's testbench-observable anchor"
    },
    "symbolic_predicates": {
      "$candidate_under_this_scenario": "symbolic condition over the named bound object; underscores delimit words",
      "$primary_and_": "symbolic condition over the named bound object; underscores delimit words"
    }
  },
  "feature_contract": {
    "provenance": "independent threat definition and RTL semantics; no downstream implementation or result input",
    "trial_parameter_policy": "candidate bits, legal values, seeds, repetitions, and bounded timing sweeps are inferred and recorded before simulation; they do not create additional semantic scenarios",
    "definition": "Measure context-averaged normalized information between primary-value groups and cumulative candidate history; conditional increments avoid recounting prior information and temporal weighting rewards earlier acquisition.",
    "execution_model": "compare legal executions that vary the primary while holding the nonsecret context and control schedule fixed",
    "calculation": "temporal incremental conditional mutual information area under the curve",
    "required_observation_roles": [
      "primary variation",
      "candidate history",
      "sampling cycles",
      "context and knownness"
    ],
    "validity_policy": [
      "legal setup and anchor are reached",
      "only the intended primary group varies within a comparison",
      "candidate samples used by the estimator are known"
    ],
    "classification": {
      "measured_nonzero": "valid positive information measurement",
      "measured_zero": "valid zero-information measurement",
      "not_applicable": "scenario is outside the candidate's declared scope",
      "invalid": "setup, variation, anchor, or knownness requirement fails"
    }
  },
  "scenario_defaults": {
    "applicability": {
      "candidate_scope": "candidate with a legal RTL path for this scenario",
      "outside_scope": "not_applicable"
    },
    "observations": [
      {
        "purpose": "measure the candidate response",
        "target": "$candidate"
      },
      {
        "purpose": "measure the primary-asset consequence",
        "target": "$primary"
      },
      {
        "purpose": "validate the scenario condition represented by scenario_phase",
        "target": "scenario_phase"
      },
      {
        "purpose": "validate the scenario condition represented by ld",
        "target": "ld"
      },
      {
        "purpose": "validate the scenario condition represented by ld_r",
        "target": "ld_r"
      },
      {
        "purpose": "validate the scenario condition represented by rst",
        "target": "rst"
      },
      {
        "purpose": "validate the scenario condition represented by candidate_4state_knownness",
        "target": "candidate_4state_knownness"
      }
    ],
    "validity": [
      "scenario_preconditions_established",
      "anchor_observed",
      "candidate_value_known_for_scored_observations",
      "control_schedule_matches_scenario",
      "same_nonsecret_context_used_across_compared_primary_values",
      "trial_parameters_and_contexts_are_not_counted_as_additional_semantic_scenarios"
    ],
    "oracle": {
      "information_dependence": [
        "measure_temporal_incremental_mutual_information_between_$primary_and_$candidate_under_this_scenario",
        "score_only_known_valid_candidate_observations",
        "retain_zero_information_as_a_valid_measurement_when_the_scenario_is_executed_correctly"
      ],
      "leakage": [
        "ICMI_establishes_primary_to_candidate_information_dependence_only",
        "candidate_to_UOP_observability_is_evaluated_separately_by_the_UOP_feature"
      ],
      "scenario_measurement": "measure temporal information dependence over the declared observation window"
    },
    "variation": {
      "held_constant": [
        "plaintext",
        "control_schedule",
        "nonvaried_primary_bits_within_each_trial_context"
      ],
      "mode": "secret_value_variation",
      "sampling_window": "scenario-defined bounded analysis window",
      "target": "$primary",
      "when": "$anchor"
    }
  },
