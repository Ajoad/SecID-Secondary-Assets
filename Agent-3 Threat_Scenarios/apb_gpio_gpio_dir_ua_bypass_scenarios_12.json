      "signal": "HRESETn",
      "active_level": "low"
    },
    "parameters": {
      "$candidate_bit": "the selected bit of the bound candidate"
    }
  },
  "feature_contract": {
    "provenance": "independent threat definition and RTL semantics; no downstream implementation or result input",
    "trial_parameter_policy": "candidate bits, legal values, seeds, repetitions, and bounded timing sweeps are inferred and recorded before simulation; they do not create additional semantic scenarios",
    "definition": "Measure the candidate-bit fraction of valid perturbation opportunities that converts a baseline-denied protected operation into an effective access or write.",
    "execution_model": "paired secure-baseline and candidate-perturbed executions from the same legal state",
    "calculation": "maximum candidate-bit deny-to-accept fraction over applicable legal scenarios",
    "required_observation_roles": [
      "candidate perturbation",
      "baseline denial",
      "protected operation or authorization decision"
    ],
    "validity_policy": [
      "legal protected-operation context is reached",
      "baseline denial is witnessed",
      "paired executions agree before intervention",
      "candidate and decision observations are known"
    ],
    "classification": {
      "bypass": "candidate mutation changes DENY to an effective protected action",
      "no_bypass": "valid mutation preserves denial",
      "not_applicable": "scenario is outside the candidate's declared scope",
      "invalid": "setup, denial, pairing, activation, or knownness requirement fails"
    }
  },
  "scenario_defaults": {
    "applicability": {
      "candidate_scope": [
        "PWRITE"
      ],
      "outside_scope": "not_applicable"
    },
    "observations": [
      {
        "purpose": "confirm the requested candidate mutation",
        "target": "$candidate_bit"
      },
      {
        "purpose": "observe the protected decision",
        "target": "$primary"
      },
      {
        "purpose": "distinguish secure denial from effective acceptance",
        "target": "later_protected_PADDIR_write"
      }
    ],
    "validity": [
      "scenario-specific legal protected-operation setup and denial anchor are reached"
    ]
  },
