  },
  "threat": "information_leakage",
  "feature": "uop_observability",
  "bindings": {
    "primary": {
      "placeholder": "$primary",
      "rtl_signal": "aes_cipher_top.key"
    },
    "candidate": {
      "placeholder": "$candidate",
      "source": "functionally retained candidate supplied to the downstream agent"
    },
    "clock": "clk",
    "reset": {
      "signal": "rst",
      "active_level": "low"
    },
    "uop": {
      "placeholder": "$uop",
      "rtl_signal": "aes_cipher_top.text_out"
    },
    "parameters": {
      "$anchor": "the current scenario's testbench-observable anchor"
    },
    "symbolic_predicates": {
      "$candidate_intervention_in_the_paired_execution": "symbolic condition over the named bound object; underscores delimit words",
      "$candidate_is_primary_sensitive_under_this_scenario": "symbolic condition over the named bound object; underscores delimit words",
      "$candidate_is_secret_dependent_on_": "symbolic condition over the named bound object; underscores delimit words",
      "$primary_under_the_same_legal_history": "symbolic condition over the named bound object; underscores delimit words",
      "$uop_difference_occurs_after_the_": "symbolic condition over the named bound object; underscores delimit words",
      "$uop_differences_as_dynamic_witnesses": "symbolic condition over the named bound object; underscores delimit words",
      "$uop_divergence": "symbolic condition over the named bound object; underscores delimit words",
      "$uop_downstream_path_is_enabled_under_this_scenario": "symbolic condition over the named bound object; underscores delimit words"
    }
  },
  "feature_contract": {
    "provenance": "independent threat definition and RTL semantics; no downstream implementation or result input",
    "trial_parameter_policy": "candidate bits, legal values, seeds, repetitions, and bounded timing sweeps are inferred and recorded before simulation; they do not create additional semantic scenarios",
    "definition": "Determine whether a legal, payload-qualified candidate perturbation has a witness at the declared untrusted observable point.",
    "execution_model": "paired baseline and candidate-perturbed executions with identical legal history before intervention",
    "calculation": "observable when a known, valid UOP divergence follows the candidate intervention; a bounded no-witness result remains unresolved",
    "required_observation_roles": [
      "candidate intervention",
      "UOP validity",
      "post-intervention UOP divergence"
    ],
    "validity_policy": [
      "candidate is primary-sensitive in the scenario",
      "paired executions agree before intervention",
      "the UOP is known and valid when compared"
    ],
    "classification": {
      "observable": "valid UOP witness",
      "unresolved": "valid bounded run without a witness",
      "not_applicable": "required candidate-to-UOP context is absent",
      "invalid": "setup, pairing, intervention, UOP-validity, or knownness requirement fails"
    }
  },
  "scenario_defaults": {
    "applicability": {
      "candidate_scope": "candidate with a legal RTL path for this scenario",
      "outside_scope": "not_applicable"
    },
    "observations": [
      {
        "purpose": "measure the candidate response",
        "target": "$candidate"
      },
      {
        "purpose": "detect a valid attacker-visible divergence",
        "target": "$uop"
      },
      {
        "purpose": "validate the scenario condition represented by scenario_phase",
        "target": "scenario_phase"
      },
      {
        "purpose": "validate the scenario condition represented by ld",
        "target": "ld"
      },
      {
        "purpose": "validate the scenario condition represented by ld_r",
        "target": "ld_r"
      },
      {
        "purpose": "validate the scenario condition represented by rst",
        "target": "rst"
      },
      {
        "purpose": "validate the scenario condition represented by candidate_4state_knownness",
        "target": "candidate_4state_knownness"
      },
      {
        "purpose": "validate the scenario condition represented by uop_4state_knownness",
        "target": "uop_4state_knownness"
      }
    ],
    "validity": [
      "scenario_preconditions_established",
      "anchor_observed",
      "$candidate_is_primary_sensitive_under_this_scenario",
      "candidate_to_$uop_downstream_path_is_enabled_under_this_scenario",
      "candidate_known_at_intervention",
      "perturbed_candidate_differs_from_baseline_candidate",
      "baseline_and_perturbed_runs_are_equivalent_before_intervention",
      "no_pre_intervention_$uop_divergence",
      "count_only_known_0_or_1_$uop_differences_as_dynamic_witnesses",
      "candidate_specific_downstream_guard_failures_are_NOT_APPLICABLE_not_UNOBSERVABLE"
    ],
    "oracle": {
      "information_dependence": [
        "scenario_is_UOP_applicable_only_when_$candidate_is_secret_dependent_on_$primary_under_the_same_legal_history"
      ],
      "leakage": [
        "OBSERVABLE_if_a_known_$uop_difference_occurs_after_the_$candidate_intervention_in_the_paired_execution",
        "dynamic_no_witness_is_UNRESOLVED_not_UNOBSERVABLE",
        "formal_fallback_may_be_used_only_for_dynamically_unresolved_applicable_cases"
      ],
      "scenario_success": "known valid UOP divergence after candidate intervention"
    },
    "intervention": {
      "comparison": "unmodified baseline versus otherwise-identical perturbed run",
      "operation": "paired_transient_candidate_perturbation",
      "release": "after the scenario-defined sensitized interval",
      "target": "$candidate",
      "when": "$anchor"
    }
  },
