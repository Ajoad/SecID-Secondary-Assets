set(var=[defines], dictionary.values.base=[binary])
set(var=[defines], fault.inject.sync=[1])
set(var=[defines], progress.enable=[1], progress.limit=[300])
set(var=[defines], progress.style=[long])
set(var=[fdef], method=[fr], fr.fr=[%FAULT_LIST%], abort=[error])
set(var=[fsim], hyperfault=[0])
